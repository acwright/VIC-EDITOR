{
  "name": "vic20-editor",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "description": "Character set and screen editor for the Commodore VIC-20 and its MOS 6560/6561 video chip",
  "author": {
    "name": "A.C. Wright",
    "email": "acwrightdesign@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acwright/VIC-EDITOR.git"
  },
  "homepage": "https://github.com/acwright/VIC-EDITOR",
  "license": "MIT",
  "main": "./out/main/index.js",
  "desktopName": "vic20-editor.desktop",
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs",
    "icons": "node scripts/generate-icons.mjs && node build/gen-icon.mjs",
    "dev": "electron-vite dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "electron-vite preview",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "run-p type-check \"build-only:web {@}\" --",
    "preview:web": "vite preview --config vite.web.config.ts",
    "test:unit": "vitest",
    "build-only": "electron-vite build",
    "build-only:web": "vite build --config vite.web.config.ts",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "pack": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && bash scripts/dist-win.sh",
    "dist:linux": "bash scripts/dist-linux.sh",
    "dist": "npm run dist:mac && npm run dist:win && npm run dist:linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.73.0",
    "prettier": "3.9.5",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
